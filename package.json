{
  "name": "menu-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "tsx watch src/main/server.ts",
    "start": "node dist/main/server.js",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write src tests scripts openapi docs-site .github/workflows *.json *.js *.ts *.md docker-compose.yml",
    "format:check": "prettier --check src tests scripts openapi docs-site .github/workflows *.json *.js *.ts *.md docker-compose.yml",
    "coverage": "vitest run --coverage",
    "openapi:lint": "spectral lint openapi/openapi.yaml",
    "benchmark": "tsx scripts/benchmark-tree.ts",
    "audit": "npm audit --omit=dev",
    "docs": "typedoc",
    "docs:md": "typedoc --options typedoc.markdown.json",
    "docs:all": "npm run docs && npm run docs:md",
    "docs:check": "typedoc --treatWarningsAsErrors --treatValidationWarningsAsErrors",
    "docs:site": "node scripts/build-docs-site.mjs",
    "docs:site:check": "npm run docs:site && node scripts/check-docs-site.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.41.0",
    "@stoplight/spectral-cli": "^6.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
